include LICENSE THIRD_PARTY_NOTICES.md CHANGELOG.md CONTRIBUTING.md SECURITY.md
include run.sh Activity-Bub.bat install-desktop.sh run_app.py requirements.txt
recursive-include activity_bub/assets *.svg *.png *.ico
recursive-include tools *.py
